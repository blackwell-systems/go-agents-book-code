{
  "id": "d3-page-offset",
  "category": "direct",
  "title": "A page offset past the end of the list",
  "notes": "store.List clamps the end of the page but not its start.",
  "version": "v1.4.0",
  "commit": "9c41e7a",
  "start": "2026-10-05T14:03:00Z",
  "steps": [
    {
