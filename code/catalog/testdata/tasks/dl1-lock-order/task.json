        "body": {
          "text": "hydrate 0",
          "every": "every 1s"
        },
        "save": "id"
      },
      {
        "as": "usr_ana",
        "method": "POST",
        "path": "/v1/reminders",
        "body": {
          "text": "hydrate 1",
          "every": "every 1s"
        },
        "save": "id"
      },
