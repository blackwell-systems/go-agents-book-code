        "path": "/v1/reminders",
        "body": {
          "text": "hydrate 5",
          "every": "every 1s"
        },
        "save": "id"
      }
    ],
    "workers": 40,
    "step": {
      "as": "usr_ana",
      "method": "POST",
      "path": "/v1/reminders/{id}/snooze",
      "body": {
        "for": "1s"
      }
    },
    "group": "A"
