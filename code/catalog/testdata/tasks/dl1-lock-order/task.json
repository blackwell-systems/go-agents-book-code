{
  "id": "dl1-lock-order",
  "category": "deadlock",
  "title": "Requests stuck behind the dispatcher",
  "notes": "flush holds the dispatcher lock while calling the store; Update holds the store lock while calling OnChange, which takes the dispatcher lock. The report is a goroutine dump from the stuck-request watchdog.",
  "version": "v1.4.0",
  "commit": "9c41e7a",
  "start": "2026-10-05T14:03:00Z",
  "stress": {
