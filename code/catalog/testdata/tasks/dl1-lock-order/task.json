  "groups": {
    "A": {
      "root_cause": [
        "notify/notify.go:(*Dispatcher).flush",
        "notify/notify.go:(*Dispatcher).forget",
        "store/store.go:(*Store).Update"
      ],
      "status": "fixed"
    }
  },
  "fix": [
    {
      "file": "notify/notify.go",
      "old": "\tmu      sync.Mutex\n\tretries map[string]int // failed sends per reminder ID",
      "new": "\tmu      sync.Mutex // serializes flushes\n\trmu     sync.Mutex // guards retries; never held while calling the store\n\tretries map[string]int // failed sends per reminder ID"
    },
    {
      "file": "notify/notify.go",
      "old": "\t\t\td.retries[r.ID]++\n\t\t\td.log.Warn(\"notify: send failed\", \"reminder\", r.ID, \"attempt\", d.retries[r.ID], \"err\", err)\n\t\t\tcontinue\n\t\t}\n\t\tdelete(d.retries, r.ID)",
      "new": "\t\t\td.rmu.Lock()\n\t\t\td.retries[r.ID]++\n\t\t\tattempt := d.retries[r.ID]\n\t\t\td.rmu.Unlock()\n\t\t\td.log.Warn(\"notify: send failed\", \"reminder\", r.ID, \"attempt\", attempt, \"err\", err)\n\t\t\tcontinue\n\t\t}\n\t\td.rmu.Lock()\n\t\tdelete(d.retries, r.ID)\n\t\td.rmu.Unlock()"
    },
    {
      "file": "notify/notify.go",
      "old": "func (d *Dispatcher) forget(r *store.Reminder) {\n\td.mu.Lock()\n\tdefer d.mu.Unlock()",
      "new": "func (d *Dispatcher) forget(r *store.Reminder) {\n\td.rmu.Lock()\n\tdefer d.rmu.Unlock()"
    }
  ]
