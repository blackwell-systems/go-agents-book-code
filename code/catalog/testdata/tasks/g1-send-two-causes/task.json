    {
      "as": "usr_bo",
      "method": "POST",
      "path": "/v1/reminders",
      "body": {
        "text": "standup notes",
        "in": "1h"
      },
      "save": "bo"
    },
    {
      "as": "usr_cy",
      "method": "POST",
      "path": "/v1/reminders/{cy}/test",
      "group": "A",
      "repeat": 2
    },
    {
      "as": "usr_bo",
      "method": "POST",
      "path": "/v1/reminders/{bo}/test",
      "group": "B",
      "repeat": 2
    }
