{
  "id": "g1-send-two-causes",
  "category": "grouping",
  "title": "Two causes on one line",
  "notes": "Both reports panic on the same line of SendNow with the same stack: one because an imported user has nil Prefs, one because the user chose \"sms\", which ValidChannel accepts but has no sender.",
  "version": "v1.4.0",
  "commit": "9c41e7a",
  "start": "2026-10-05T14:03:00Z",
  "extra_users": [
    {
