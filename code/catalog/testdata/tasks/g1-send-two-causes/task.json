      "status": "fixed"
    }
  },
  "fix": [
    {
      "file": "store/users.go",
      "old": "\t\tif _, ok := s.users[u.ID]; ok {\n\t\t\tcontinue\n\t\t}\n\t\ts.users[u.ID] = &u",
      "new": "\t\tif _, ok := s.users[u.ID]; ok {\n\t\t\tcontinue\n\t\t}\n\t\tif u.Prefs == nil {\n\t\t\tu.Prefs = DefaultPrefs()\n\t\t}\n\t\ts.users[u.ID] = &u"
    },
    {
      "file": "notify/notify.go",
      "old": "var channels = []string{\"email\", \"webhook\", \"sms\"}",
      "new": "var channels = []string{\"email\", \"webhook\"}"
    }
  ],
  "noise": [
    "d2-clock-no-minutes",
    "d4-preview-multibyte"
  ],
  "decoys": [
    [
      {
        "file": "notify/notify.go",
        "old": "\tif err := d.senders[u.Prefs.Channel].Send(ctx, message(u, r)); err != nil {",
        "new": "\tif u.Prefs == nil {\n\t\treturn fmt.Errorf(\"send %s: user %s has no preferences\", r.ID, u.ID)\n\t}\n\tif err := d.senders[u.Prefs.Channel].Send(ctx, message(u, r)); err != nil {"
      }
    ]
  ]
