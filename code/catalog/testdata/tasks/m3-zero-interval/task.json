        "file": "schedule/every.go",
        "old": "\tn := after.Sub(e.Start) / e.Interval",
        "new": "\tif e.Interval <= 0 {\n\t\treturn time.Time{}\n\t}\n\tn := after.Sub(e.Start) / e.Interval"
      }
